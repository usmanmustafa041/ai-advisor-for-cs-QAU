# Portal API (backend/app) when run WITHOUT Docker, e.g. `uvicorn app.main:app --reload`.
# Copy to backend/.env. Values here override the repository-root .env.
# Docker Compose does not use this file; it reads the root .env instead.
APP_NAME=QAU CS Academic Advisor API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
# Docker's PostgreSQL is published on localhost:55432 (POSTGRES_PORT in the root .env).
DATABASE_URL=postgresql+psycopg://qau_advisor:CHANGE_ME@localhost:55432/qau_advisor
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Required (32+ random characters) when APP_ENV=production.
AUTH_SECRET=
EMBEDDING_PROVIDER=sentence-transformer
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_LOCAL_FILES_ONLY=true
NLP_CLASSIFIER_BACKEND=baseline
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=45
LLM_CHECK_CLAIMS=true
LLM_KEEP_ALIVE=15m
RAG_CORPUS_PATH=data/rag/corpus.jsonl
RAG_RERANKER_MODEL=
