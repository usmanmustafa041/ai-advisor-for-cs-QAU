# Copy to .env.advisor (or set these as real environment variables). All optional.

# --- storage ---
# ADVISOR_DATA_DIR=/var/lib/qau-advisor

# --- first administrator (created once, only if no admin exists yet) ---
# Alternative: python -m advisor.cli create-admin <username>
# ADVISOR_BOOTSTRAP_ADMIN_USER=admin
# ADVISOR_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# --- AI providers: normally set from the admin console (Admin → AI providers) ---
# ADVISOR_GEMINI_API_KEY=            # bootstrap default; the admin console value wins
# ADVISOR_GEMINI_MODEL=gemini-2.5-flash
# ADVISOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
# ADVISOR_OLLAMA_MODEL=qwen3:8b

# --- security ---
# ADVISOR_SECRET_KEY=                # master key for encrypting stored secrets (auto-generated file if blank)
# ADVISOR_CORS_ORIGINS=["https://cs.qau.edu.pk"]
# ADVISOR_TRUST_PROXY_HEADERS=true   # set when behind nginx/Caddy so rate limits use the real client IP
# ADVISOR_RATE_LIMIT_PER_MINUTE=20

# --- serving the web UI from the API process ---
# ADVISOR_SERVE_FRONTEND_DIR=../web/dist

# --- retrieval models (downloaded once, then cached) ---
# ADVISOR_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# ADVISOR_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# ADVISOR_MODELS_LOCAL_ONLY=false

# --- conversation history (inference settings and prompts are unchanged) ---
# Bounds are further reduced to the space left in the verified model window.
# ADVISOR_MEMORY_HISTORY_TOKENS=2400
# ADVISOR_MEMORY_SUMMARY_TOKENS=900
# ADVISOR_MEMORY_COMPACT_TRIGGER_TOKENS=3600
# ADVISOR_MEMORY_RECENT_TURNS=3
# ADVISOR_MEMORY_SCAN_MESSAGES=200
# ADVISOR_MEMORY_SAFETY_FRACTION=0.15
# ADVISOR_MEMORY_SAFETY_TOKENS=256
# ADVISOR_MEMORY_METADATA_TTL_SECONDS=600
# ADVISOR_MEMORY_METADATA_TIMEOUT_SECONDS=3
# ADVISOR_MEMORY_LEASE_SECONDS=300
# ADVISOR_MEMORY_LOCK_TIMEOUT_SECONDS=150
# ADVISOR_MEMORY_EXACT_REMOTE_COUNT=true
# Optional operator-verified capacity overrides, not assumed model capacities:
# ADVISOR_MEMORY_CONTEXT_LIMITS={"ollama/qwen3:8b":12288}
# Optional EXISTING compatible local tokenizer directories; never downloaded:
# ADVISOR_MEMORY_TOKENIZER_PATHS={"ollama/qwen3:8b":"/path/to/qwen3-tokenizer"}
# Durable summaries / cross-process leases require the explicit migration in
# docs/CONVERSATION_MEMORY.md. Application startup never applies it.
