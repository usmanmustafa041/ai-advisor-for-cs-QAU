# QAU CS Advisor — settings for the Docker Compose stack (docker compose up).
# Copy to .env in this folder and fill in the three secrets marked REQUIRED.
# Never commit .env. For running the backend without Docker, see backend/.env.example.
#
# Generate a random value (any machine with Python):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database (REQUIRED: POSTGRES_PASSWORD) ------------------------------------
# The password is fixed when the database volume is first created. Changing it later
# requires changing it inside PostgreSQL too (or recreating the volume).
POSTGRES_DB=qau_advisor
POSTGRES_USER=qau_advisor
POSTGRES_PASSWORD=
# Host port for PostgreSQL, bound to 127.0.0.1 only (not reachable from the network).
POSTGRES_PORT=55432

# --- Portal security (REQUIRED: AUTH_SECRET, at least 32 random characters) ----
APP_ENV=production
AUTH_SECRET=
# Only needed if another website calls the API directly; the bundled UI does not.
CORS_ORIGINS=["http://localhost"]

# --- Web --------------------------------------------------------------------------
# Port students open in the browser (http://<server-address>:WEB_PORT).
WEB_PORT=80

# --- Language model ---------------------------------------------------------------
# Hosted Gemini is the fastest option and needs no GPU. Key: https://aistudio.google.com
# It can also be set later from the admin panel (Chatbot Engine -> AI providers).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Local Ollama model (only with: docker compose --profile local-llm up; needs an NVIDIA GPU).
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://ollama:11434
LLM_TIMEOUT_SECONDS=45
LLM_CHECK_CLAIMS=true
ADVISOR_ANSWER_TIMEOUT_SECONDS=240

# --- Retrieval / NLP (defaults are fine) --------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
NLP_CLASSIFIER_BACKEND=baseline
NLP_MODEL_NAME=distilbert-base-multilingual-cased
NLP_MODEL_PATH=models/qau-intent-distilmbert
NLP_MAX_LENGTH=128

# --- Data handling --------------------------------------------------------------------
CMS_ENABLED=false
STUDENT_ALLOWED_FIELDS=[]
DATA_RETENTION_DAYS=30
